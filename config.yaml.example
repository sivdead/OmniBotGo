# OmniBotGo 配置文件模板
# 复制此文件为 config.yaml 并填入实际配置值

# 应用程序配置
app:
  name: "OmniBotGo"
  version: "1.0.0"

# HTTP 服务器配置
http:
  port: "8080"
  use_prefork_mode: false

# 日志配置
log:
  level: "debug"

# 数据库配置
db:
  type: "mysql"
  dsn: "username:password@tcp(localhost:3306)/database_name?charset=utf8mb4&parseTime=True&loc=Local"
  max_connections: 10
  log_level: "warn"  # 数据库日志级别 (error, warn, info, debug)
  slow_threshold: 200  # 慢查询阈值(毫秒)，超过此时间的查询将被标记为慢查询

# gRPC 服务器配置
grpc:
  port: "8081"

# RabbitMQ 配置
rmq:
  server_exchange: "rpc_server"
  client_exchange: "rpc_client"
  url: "amqp://username:password@localhost:5672/"

# 监控配置
metrics:
  enabled: true

# Swagger 文档配置
swagger:
  enabled: true

# 速率限制配置
rate_limit:
  # 全局限制（所有请求，-1表示不限制）
  global_max: 1000        # 全局最大请求数
  global_expiration: 60   # 全局时间窗口（秒）
  
  # 每个IP限制（-1表示不限制）
  per_ip_max: 100         # 每个IP最大请求数
  per_ip_expiration: 60   # 每个IP时间窗口（秒）
  
  # 每个用户限制（需要认证，-1表示不限制）
  per_user_max: 200       # 每个用户最大请求数
  per_user_expiration: 60 # 每个用户时间窗口（秒）
  
  # 并发限制（-1表示不限制）
  max_workers: 100        # 最大并发工作协程数
  max_requests: 1000      # 最大同时处理请求数