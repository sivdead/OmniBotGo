### 健康检查
```go
// HealthCheck 健康检查
// @Summary 系统健康检查
// @Description 检查系统各组件状态
// @Tags system
// @Produce json
// @Success 200 {object} HealthResponse
// @Router /healthz [get]
func (c *Controller) HealthCheck(ctx *fiber.Ctx) error {
    return ctx.JSON(HealthResponse{
        Status:    "ok",
        Timestamp: time.Now(),
        Services: map[string]string{
            "database": "healthy",
            "rabbitmq": "healthy",
        },
    })
}
```
