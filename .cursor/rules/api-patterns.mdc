}

func (s *GRPCController) SendMessage(ctx context.Context, req *pb.SendMessageRequest) (*pb.SendMessageResponse, error) {
    // 实现逻辑
}
```

## 中间件

### 认证中间件
```go
func AuthMiddleware() fiber.Handler {
    return func(c *fiber.Ctx) error {
        token := c.Get("Authorization")
        if token == "" {
            return c.Status(401).JSON(Response{
                Success: false,
                Error:   "Missing authorization token",
                Code:    401,
            })
        }
        // 验证token逻辑
        return c.Next()
    }
}
```

### 日志中间件
```go
func LoggingMiddleware(logger *zerolog.Logger) fiber.Handler {
    return logger.Request(zerolog.RequestLogger{
        GetLogger: func(c *fiber.Ctx) zerolog.Logger {
            return logger.With().
                Str("method", c.Method()).
                Str("path", c.Path()).
                Logger()
        },
    })
}
```

### 限流中间件
```go
func RateLimitMiddleware() fiber.Handler {
    return limiter.New(limiter.Config{
        Max:        100,
        Expiration: 1 * time.Minute,
        KeyGenerator: func(c *fiber.Ctx) string {
            return c.IP()
        },
    })
}
```

## WebHook处理

### 平台WebHook接收
为每个平台提供专用的WebHook端点：

```go
// 企业微信WebHook
func (c *Controller) WeComWebHook(ctx *fiber.Ctx) error {
    var event WeComEvent
    if err := ctx.BodyParser(&event); err != nil {
        return c.errorResponse(ctx, 400, "Invalid request body")
    }
    
    return c.usecase.HandleWeComEvent(ctx.Context(), &event)
}

// 钉钉WebHook  
func (c *Controller) DingTalkWebHook(ctx *fiber.Ctx) error {
    var event DingTalkEvent
    if err := ctx.BodyParser(&event); err != nil {
        return c.errorResponse(ctx, 400, "Invalid request body")
    }
    
    return c.usecase.HandleDingTalkEvent(ctx.Context(), &event)
}
```

### 签名验证
```go
func VerifyWebHookSignature(secret string, signature string, body []byte) bool {
    mac := hmac.New(sha256.New, []byte(secret))
    mac.Write(body)
    expectedSignature := hex.EncodeToString(mac.Sum(nil))
    return hmac.Equal([]byte(signature), []byte(expectedSignature))
}
```

