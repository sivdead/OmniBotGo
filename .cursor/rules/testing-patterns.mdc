## 性能测试

### 基准测试
```go
func BenchmarkMessageUseCase_SendMessage(b *testing.B) {
    usecase := setupBenchmarkUseCase(b)
    msg := CreateTestMessage()
    
    b.ResetTimer()
    for i := 0; i < b.N; i++ {
        err := usecase.SendMessage(context.Background(), msg)
        if err != nil {
            b.Fatal(err)
        }
    }
}
```

